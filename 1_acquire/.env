# ============================================================
# SmartUsDisplay.py - B-mode configuration (SmartUS probe)
# All display / scan / recording settings live here.
# Scan values marked (0-100) are percentage indices, (dB) are dB.
# Leave a scan value EMPTY to keep the device default.
# ============================================================

# ---------- Image / display ----------
IMAGE_WIDTH=512
IMAGE_HEIGHT=512
WINDOW_TITLE=SmartUS B-mode Display

# ---------- Scan settings applied at startup ----------
GAIN=90            # B gain index (0-90)
POWER=20           # B power index (0-20 dB)
DEPTH_MM=40          # depth in mm, e.g. 60 (empty = device default)
FOCUS_DEPTH_MM=    # focal depth in mm, e.g. 30 (empty = device default)
DYNAMIC_RANGE_DB=  # dynamic range in dB, e.g. 60 (empty = device default)
LINES_DENSITY_IDX=32 # lines density: 8=Low, 16=Medium, 22=Standard S, 24=Standard, 32=High (empty = default)
VIEW_AREA_PCT=     # view area in % (50-100), e.g. 100 (empty = device default)

# Scan type: 0=B Standard, 1=B WideView, 2=B Compound
SCAN_TYPE=0
WIDE_VIEW_ANGLE_DEG=   # wide view angle in deg, used when SCAN_TYPE=1
COMPOUND_ANGLE_DEG=    # compound angle in deg, used when SCAN_TYPE=2
COMPOUND_FRAMES=       # compound frames number, used when SCAN_TYPE=2

TGC1_PCT=50        # TGC zone 1 level (0-100)
TGC2_PCT=60        # TGC zone 2 level (0-100)
TGC3_PCT=60        # TGC zone 3 level (0-100)
TGC4_PCT=60        # TGC zone 4 level (0-100)
TGC5_PCT=60        # TGC zone 5 level (0-100)

# ---------- Recording ----------
# Save B-mode snapshots as PNG files at a fixed interval (true/false)
RECORD_IMAGE=false
IMAGE_SAVE_INTERVAL_SEC=5.0
# Record B-mode video as MP4 (true/false). Starts immediately on launch.
RECORD_VIDEO=false
VIDEO_FPS=25
# Root folder for all recordings: <OUTPUT_DIR>/images, <OUTPUT_DIR>/video
OUTPUT_DIR=../data
